# Multi-stage production build for Fly.io deployment.
# Stage 1: build the React/CesiumJS frontend.
# Stage 2: build all Go binaries.
# Stage 3: minimal alpine runtime with everything wired together.

FROM node:20-alpine AS frontend
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --prefer-offline
COPY frontend/ ./
# VITE_CESIUM_TOKEN is baked into the JS bundle at build time by Vite.
# Pass it via: fly deploy --build-arg VITE_CESIUM_TOKEN=<your-token>
# Without it the globe still works — terrain/imagery tiles just won't load.
ARG VITE_CESIUM_TOKEN=""
ENV VITE_CESIUM_TOKEN=$VITE_CESIUM_TOKEN
RUN npm run build

FROM golang:1.22-alpine AS gobuilder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /bin/groundstation ./cmd/groundstation
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /bin/spacecraft   ./cmd/spacecraft
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /bin/relay        ./cmd/relay
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /bin/relay2       ./cmd/relay2

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tini

COPY --from=gobuilder /bin/groundstation /bin/spacecraft /bin/relay /bin/relay2 /usr/local/bin/
COPY --from=frontend  /src/frontend/dist /app/dist
COPY scripts/start-fly.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 8080
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/start.sh"]
