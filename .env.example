# Copy this to .env and fill in values before running docker compose.
#
# ORBITRON_HMAC_KEY — required. 32+ random hex bytes shared between spacecraft
# and groundstation for HMAC-SHA256 frame authentication.
# Generate with: openssl rand -hex 32
ORBITRON_HMAC_KEY=

# VITE_CESIUM_TOKEN — optional. Cesium Ion access token for 3D terrain and
# satellite imagery tiles. Required for the terminator (day/night line).
# Without it the globe still renders satellites and ISL beams but no terminator.
# Get a free token at: https://cesium.com/ion/tokens
VITE_CESIUM_TOKEN=

# ANTHROPIC_API_KEY — required for /query-health-ai command.
# The spacecraft service calls Claude API to stream AI health diagnostics.
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
