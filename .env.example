# Copy this to .env and fill in values before running docker compose.
#
# ORBITRON_HMAC_KEY — required. 32+ random hex bytes shared between spacecraft
# and groundstation for HMAC-SHA256 frame authentication.
# Generate with: openssl rand -hex 32
ORBITRON_HMAC_KEY=

# VITE_CESIUM_TOKEN — optional. Cesium Ion access token for 3D terrain and
# satellite imagery tiles. Without it the globe still renders satellites and
# ISL beams but shows no terrain or imagery.
# Get a free token at: https://cesium.com/ion/tokens
VITE_CESIUM_TOKEN=
